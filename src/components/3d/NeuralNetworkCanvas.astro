---
// NeuralNetworkCanvas component - Animated neural network visualization
// client:load for Three.js
interface Props {
  class?: string;
  nodeCount?: number;
  connectionProbability?: number;
}

const { class: className = '', nodeCount = 40, connectionProbability = 0.12 } = Astro.props;
---

<div class={`neural-network-canvas ${className}`} data-neural-canvas aria-hidden="true"></div>

<script>
  import * as THREE from 'three';
  import { prefersReducedMotion } from '../../utils/scroll';

  const container = document.currentScript?.parentElement?.closest('[data-neural-canvas]') as HTMLElement;
  if (!container) return;

  const prefersReduced = prefersReducedMotion();

  // Scene setup
  const scene = new THREE.Scene();
  
  const camera = new THREE.PerspectiveCamera(
    50,
    container.clientWidth / container.clientHeight,
    0.1,
    100
  );
  camera.position.z = 8;

  const renderer = new THREE.WebGLRenderer({
    antialias: true,
    alpha: true,
    powerPreference: 'high-performance',
  });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);
  container.appendChild(renderer.domElement);

  // Colors
  const goldColor = new THREE.Color(0xe8b44a);
  const brightGoldColor = new THREE.Color(0xfde047);
  const whiteColor = new THREE.Color(0xfafafa);
  const dimColor = new THREE.Color(0x71717a);

  // Create nodes
  const nodes: {
    mesh: THREE.Mesh;
    basePosition: THREE.Vector3;
    phase: number;
    color: THREE.Color;
    size: number;
  }[] = [];

  const nodeGeometry = new THREE.SphereGeometry(0.06, 16, 16);
  
  for (let i = 0; i < nodeCount; i++) {
    const colorRand = Math.random();
    let color: THREE.Color;
    if (colorRand < 0.15) color = goldColor.clone();
    else if (colorRand < 0.3) color = brightGoldColor.clone();
    else if (colorRand < 0.6) color = whiteColor.clone();
    else color = dimColor.clone();

    const material = new THREE.MeshBasicMaterial({
      color,
      transparent: true,
      opacity: 0.8,
    });

    const mesh = new THREE.Mesh(nodeGeometry, material);
    
    const basePosition = new THREE.Vector3(
      (Math.random() - 0.5) * 10,
      (Math.random() - 0.5) * 6,
      (Math.random() - 0.5) * 5
    );
    mesh.position.copy(basePosition);
    
    scene.add(mesh);
    
    nodes.push({
      mesh,
      basePosition,
      phase: Math.random() * Math.PI * 2,
      color,
      size: 0.8 + Math.random() * 0.6,
    });
  }

  // Create connections
  const connections: { from: number; to: number; line: THREE.Line }[] = [];
  const lineMaterial = new THREE.LineBasicMaterial({
    color: 0xe8b44a,
    transparent: true,
    opacity: 0.15,
  });

  for (let i = 0; i < nodeCount; i++) {
    for (let j = i + 1; j < nodeCount; j++) {
      if (Math.random() < connectionProbability) {
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
        const line = new THREE.Line(geometry, lineMaterial.clone());
        scene.add(line);
        connections.push({ from: i, to: j, line });
      }
    }
  }

  // Animation
  let time = 0;
  let animationId: number;

  function animate() {
    if (prefersReduced) return;
    
    time += 0.016;

    // Animate nodes
    nodes.forEach((node, i) => {
      const pos = node.mesh.position;
      pos.x = node.basePosition.x + Math.sin(time * 0.5 + node.phase) * 0.3;
      pos.y = node.basePosition.y + Math.cos(time * 0.3 + node.phase) * 0.2;
      pos.z = node.basePosition.z + Math.sin(time * 0.4 + node.phase) * 0.3;
      
      const scale = node.size + Math.sin(time * 2 + node.phase) * 0.15;
      node.mesh.scale.setScalar(scale);
      
      // Pulse opacity for gold nodes
      if (node.color.equals(goldColor) || node.color.equals(brightGoldColor)) {
        (node.mesh.material as THREE.MeshBasicMaterial).opacity = 0.6 + Math.sin(time * 3 + node.phase) * 0.3;
      }
    });

    // Update connections
    connections.forEach(conn => {
      const from = nodes[conn.from].mesh.position;
      const to = nodes[conn.to].mesh.position;
      const positions = conn.line.geometry.getAttribute('position');
      positions.array[0] = from.x; positions.array[1] = from.y; positions.array[2] = from.z;
      positions.array[3] = to.x; positions.array[4] = to.y; positions.array[5] = to.z;
      positions.needsUpdate = true;
      
      // Opacity based on distance
      const dist = from.distanceTo(to);
      (conn.line.material as THREE.LineBasicMaterial).opacity = Math.max(0.05, 0.3 - dist * 0.02);
    });

    // Slow rotation
    scene.rotation.y += 0.0003;
    scene.rotation.x += 0.0001;

    renderer.render(scene, camera);
    animationId = requestAnimationFrame(animate);
  }

  animate();

  // Resize
  function onResize() {
    const rect = container.getBoundingClientRect();
    camera.aspect = rect.width / rect.height;
    camera.updateProjectionMatrix();
    renderer.setSize(rect.width, rect.height);
  }

  window.addEventListener('resize', onResize);

  // Cleanup
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      for (const node of mutation.removedNodes) {
        if (node === container || node.contains(container)) {
          window.removeEventListener('resize', onResize);
          cancelAnimationFrame(animationId);
          renderer.dispose();
          nodes.forEach(n => {
            n.mesh.geometry.dispose();
            (n.mesh.material as THREE.Material).dispose();
          });
          connections.forEach(c => {
            c.line.geometry.dispose();
            (c.line.material as THREE.Material).dispose();
          });
          observer.disconnect();
          return;
        }
      }
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>

<style>
  .neural-network-canvas {
    width: 100%;
    height: 100%;
    min-height: 300px;
    position: relative;
  }
  
  .neural-network-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>