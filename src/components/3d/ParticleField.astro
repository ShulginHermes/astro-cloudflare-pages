---
// ParticleField component - Three.js particle field with 15k points and GPU vertex shader
// client:load for immediate Three.js initialization
---

<div id="particle-field" class="w-full h-full" aria-hidden="true"></div>

<script>
  import * as THREE from 'three';
  import { createParticleGeometry, particleVertexShader, particleFragmentShader } from '../../scripts/three-utils';
  import { prefersReducedMotion } from '../../utils/scroll';

  (() => {
    const container = document.getElementById('particle-field');
    if (!container) return;

    const prefersReduced = prefersReducedMotion();

    // Scene setup
    const scene = new THREE.Scene();
    
    const camera = new THREE.PerspectiveCamera(
      60,
      container.clientWidth / container.clientHeight,
      0.1,
      1000
    );
    camera.position.z = 50;

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    // Create particle geometry (15,000 points)
    const PARTICLE_COUNT = 15000;
    const geometry = createParticleGeometry(PARTICLE_COUNT, 60);

    // Shader material
    const material = new THREE.ShaderMaterial({
      vertexShader: particleVertexShader,
      fragmentShader: particleFragmentShader,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uScrollProgress: { value: 0 },
        uMouse: { value: new THREE.Vector2(0.5, 0.5) },
        uReducedMotion: { value: prefersReduced ? 1 : 0 },
      },
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // Mouse tracking
    let mouseX = 0.5;
    let mouseY = 0.5;

    function onMouseMove(event: MouseEvent) {
      mouseX = event.clientX / window.innerWidth;
      mouseY = 1 - event.clientY / window.innerHeight;
    }

    window.addEventListener('mousemove', onMouseMove);

    // Scroll progress tracking
    let scrollProgress = 0;
    
    function updateScrollProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      scrollProgress = Math.min(scrollTop / docHeight, 1);
    }

    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    updateScrollProgress();

    // Reduced motion listener
    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    function handleReducedMotionChange(e: MediaQueryListEvent) {
      material.uniforms.uReducedMotion.value = e.matches ? 1 : 0;
    }
    mediaQuery.addEventListener('change', handleReducedMotionChange);

    // Animation loop
    let startTime = performance.now();
    
    function animate() {
      const currentTime = performance.now();
      const elapsed = currentTime - startTime;

      material.uniforms.uTime.value = elapsed;
      material.uniforms.uScrollProgress.value = scrollProgress;
      material.uniforms.uMouse.value.set(mouseX, mouseY);

      // Slow rotation
      if (!prefersReduced) {
        particles.rotation.y += 0.00005;
        particles.rotation.x += 0.00002;
      }

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    animate();

    // Resize handler
    function onResize() {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    }

    window.addEventListener('resize', onResize);

    // Cleanup
    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        for (const node of mutation.removedNodes) {
          if (node === container) {
            window.removeEventListener('mousemove', onMouseMove);
            window.removeEventListener('scroll', updateScrollProgress);
            window.removeEventListener('resize', onResize);
            mediaQuery.removeEventListener('change', handleReducedMotionChange);
            renderer.dispose();
            geometry.dispose();
            material.dispose();
            observer.disconnect();
            return;
          }
        }
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>

<style>
  #particle-field {
    width: 100%;
    height: 100%;
    position: relative;
  }
  
  #particle-field canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>