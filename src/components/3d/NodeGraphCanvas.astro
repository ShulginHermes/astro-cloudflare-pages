---
// NodeGraphCanvas component - Animated node graph for automation visualization
// client:load for Three.js
interface Props {
  class?: string;
  nodeCount?: number;
}

const { class: className = '', nodeCount = 25 } = Astro.props;
---

<div class={`node-graph-canvas ${className}`} data-node-graph-canvas aria-hidden="true"></div>

<script>
  import * as THREE from 'three';
  import { prefersReducedMotion } from '../../utils/scroll';

  const container = document.currentScript?.parentElement?.closest('[data-node-graph-canvas]') as HTMLElement;
  if (!container) return;

  const prefersReduced = prefersReducedMotion();

  // Scene setup
  const scene = new THREE.Scene();
  
  const camera = new THREE.PerspectiveCamera(
    50,
    container.clientWidth / container.clientHeight,
    0.1,
    100
  );
  camera.position.z = 10;

  const renderer = new THREE.WebGLRenderer({
    antialias: true,
    alpha: true,
    powerPreference: 'high-performance',
  });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);
  container.appendChild(renderer.domElement);

  // Colors
  const goldColor = new THREE.Color(0xe8b44a);
  const brightGoldColor = new THREE.Color(0xfde047);
  const surfaceColor = new THREE.Color(0x18181b);
  const borderColor = new THREE.Color(0x27272a);

  // Node types
  type NodeType = 'trigger' | 'action' | 'condition' | 'transform';
  
  const nodes: {
    mesh: THREE.Mesh;
    basePosition: THREE.Vector3;
    type: NodeType;
    phase: number;
    connections: number[];
  }[] = [];

  // Create different geometries for node types
  const geometries = {
    trigger: new THREE.BoxGeometry(0.35, 0.35, 0.35),
    action: new THREE.OctahedronGeometry(0.25, 0),
    condition: new THREE.CylinderGeometry(0.25, 0.25, 0.4, 6),
    transform: new THREE.TetrahedronGeometry(0.25, 0),
  };

  const typeColors = {
    trigger: goldColor,
    action: brightGoldColor,
    condition: new THREE.Color(0xfafafa),
    transform: new THREE.Color(0x71717a),
  };

  const types: NodeType[] = ['trigger', 'action', 'condition', 'transform'];

  for (let i = 0; i < nodeCount; i++) {
    const type = types[Math.floor(Math.random() * types.length)];
    const geometry = geometries[type];
    const material = new THREE.MeshBasicMaterial({
      color: typeColors[type],
      transparent: true,
      opacity: 0.9,
      wireframe: type === 'transform',
    });

    const mesh = new THREE.Mesh(geometry, material);
    
    const basePosition = new THREE.Vector3(
      (Math.random() - 0.5) * 12,
      (Math.random() - 0.5) * 7,
      (Math.random() - 0.5) * 6
    );
    mesh.position.copy(basePosition);
    
    scene.add(mesh);
    
    nodes.push({
      mesh,
      basePosition,
      type,
      phase: Math.random() * Math.PI * 2,
      connections: [],
    });
  }

  // Create connections (hierarchical flow)
  const connections: { from: number; to: number; line: THREE.Line; progress: number }[] = [];
  const lineMaterial = new THREE.LineBasicMaterial({
    color: 0xe8b44a,
    transparent: true,
    opacity: 0.3,
  });

  // Connect nodes in a flow-like pattern
  for (let i = 0; i < nodeCount - 1; i++) {
    const numConnections = 1 + Math.floor(Math.random() * 2);
    for (let c = 0; c < numConnections; c++) {
      const to = Math.min(i + 1 + Math.floor(Math.random() * 3), nodeCount - 1);
      if (to > i) {
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
        const line = new THREE.Line(geometry, lineMaterial.clone());
        scene.add(line);
        connections.push({ from: i, to, line, progress: 0 });
        nodes[i].connections.push(connections.length - 1);
      }
    }
  }

  // Flowing particles along connections
  const flowParticles: {
    connectionIndex: number;
    progress: number;
    speed: number;
    mesh: THREE.Mesh;
  }[] = [];

  const particleGeometry = new THREE.SphereGeometry(0.04, 8, 8);
  const particleMaterial = new THREE.MeshBasicMaterial({
    color: 0xfde047,
    transparent: true,
    opacity: 1,
  });

  connections.forEach((conn, idx) => {
    const numParticles = 2 + Math.floor(Math.random() * 2);
    for (let p = 0; p < numParticles; p++) {
      const mesh = new THREE.Mesh(particleGeometry, particleMaterial.clone());
      mesh.visible = false;
      scene.add(mesh);
      flowParticles.push({
        connectionIndex: idx,
        progress: p / numParticles,
        speed: 0.3 + Math.random() * 0.4,
        mesh,
      });
    }
  });

  // Animation
  let time = 0;
  let animationId: number;

  function animate() {
    if (prefersReduced) return;
    
    time += 0.016;

    // Animate nodes
    nodes.forEach((node, i) => {
      const pos = node.mesh.position;
      const floatAmount = node.type === 'trigger' ? 0.4 : 0.2;
      pos.y = node.basePosition.y + Math.sin(time * 0.8 + node.phase) * floatAmount;
      pos.x = node.basePosition.x + Math.cos(time * 0.5 + node.phase) * 0.15;
      
      // Rotate based on type
      if (node.type === 'action') {
        node.mesh.rotation.y += 0.01;
        node.mesh.rotation.x += 0.005;
      } else if (node.type === 'transform') {
        node.mesh.rotation.z += 0.008;
      }
      
      // Pulse for trigger nodes
      if (node.type === 'trigger') {
        const scale = 1 + Math.sin(time * 2 + node.phase) * 0.1;
        node.mesh.scale.setScalar(scale);
      }
    });

    // Update connections
    connections.forEach(conn => {
      const from = nodes[conn.from].mesh.position;
      const to = nodes[conn.to].mesh.position;
      const positions = conn.line.geometry.getAttribute('position');
      positions.array[0] = from.x; positions.array[1] = from.y; positions.array[2] = from.z;
      positions.array[3] = to.x; positions.array[4] = to.y; positions.array[5] = to.z;
      positions.needsUpdate = true;
    });

    // Animate flow particles
    flowParticles.forEach(particle => {
      const conn = connections[particle.connectionIndex];
      const from = nodes[conn.from].mesh.position;
      const to = nodes[conn.to].mesh.position;
      
      particle.progress += particle.speed * 0.016;
      if (particle.progress > 1) {
        particle.progress = 0;
      }
      
      const pos = particle.mesh.position;
      pos.lerpVectors(from, to, particle.progress);
      
      // Fade in/out at ends
      const fade = Math.min(particle.progress * 3, (1 - particle.progress) * 3, 1);
      (particle.mesh.material as THREE.MeshBasicMaterial).opacity = fade;
      particle.mesh.visible = fade > 0.05;
      
      // Scale pulse
      const scale = 0.8 + Math.sin(particle.progress * Math.PI * 4) * 0.3;
      particle.mesh.scale.setScalar(scale);
    });

    // Slow scene rotation
    scene.rotation.y += 0.0002;

    renderer.render(scene, camera);
    animationId = requestAnimationFrame(animate);
  }

  animate();

  // Resize
  function onResize() {
    const rect = container.getBoundingClientRect();
    camera.aspect = rect.width / rect.height;
    camera.updateProjectionMatrix();
    renderer.setSize(rect.width, rect.height);
  }

  window.addEventListener('resize', onResize);

  // Cleanup
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      for (const node of mutation.removedNodes) {
        if (node === container || node.contains(container)) {
          window.removeEventListener('resize', onResize);
          cancelAnimationFrame(animationId);
          renderer.dispose();
          nodes.forEach(n => {
            n.mesh.geometry.dispose();
            (n.mesh.material as THREE.Material).dispose();
          });
          connections.forEach(c => {
            c.line.geometry.dispose();
            (c.line.material as THREE.Material).dispose();
          });
          flowParticles.forEach(p => {
            p.mesh.geometry.dispose();
            (p.mesh.material as THREE.Material).dispose();
          });
          observer.disconnect();
          return;
        }
      }
    }
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>

<style>
  .node-graph-canvas {
    width: 100%;
    height: 100%;
    min-height: 300px;
    position: relative;
  }
  
  .node-graph-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>