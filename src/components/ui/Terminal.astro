---
// Terminal component - animated terminal typing effect
interface Props {
  commands: {
    command: string;
    output?: string;
    delay?: number; // ms before next command
  }[];
  class?: string;
}

const { commands, class: className = '' } = Astro.props;
---

<div class={`terminal ${className}`} data-terminal>
  <div class="terminal-header">
    <div class="terminal-dots">
      <span class="dot close"></span>
      <span class="dot minimize"></span>
      <span class="dot maximize"></span>
    </div>
    <div class="terminal-title">terminal</div>
  </div>
  <div class="terminal-body">
    <div class="terminal-content" data-terminal-content></div>
    <div class="terminal-input-line">
      <span class="prompt">$</span>
      <span class="cursor" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion } from '../../utils/scroll';

  gsap.registerPlugin(ScrollTrigger);

  (() => {
    const terminal = document.currentScript?.parentElement?.closest('[data-terminal]') as HTMLElement;
    if (!terminal) return;

    const content = terminal.querySelector('[data-terminal-content]') as HTMLElement;
    const cursor = terminal.querySelector('.cursor') as HTMLElement;
    
    if (!content || !cursor) return;

    const prefersReduced = prefersReducedMotion();

    // Blinking cursor animation
    if (!prefersReduced) {
      gsap.to(cursor, {
        opacity: 0,
        duration: 0.5,
        repeat: -1,
        yoyo: true,
        ease: 'none',
      });
    }

    // Type text character by character
    function typeText(element: HTMLElement, text: string, speed: number = 30): Promise<void> {
      return new Promise(resolve => {
        if (prefersReduced) {
          element.textContent = text;
          resolve();
          return;
        }
        
        let i = 0;
        const timer = setInterval(() => {
          element.textContent += text[i];
          i++;
          if (i >= text.length) {
            clearInterval(timer);
            resolve();
          }
        }, speed);
      });
    }

    // Run command sequence
    async function runCommands() {
      for (const cmd of commands) {
        // Create command line
        const line = document.createElement('div');
        line.className = 'terminal-line';
        line.innerHTML = `<span class="prompt">$</span> <span class="command"></span>`;
        const commandEl = line.querySelector('.command') as HTMLElement;
        content.appendChild(line);
        
        // Type command
        await typeText(commandEl, cmd.command, 20);
        
        // Add output if exists
        if (cmd.output) {
          const outputLine = document.createElement('div');
          outputLine.className = 'terminal-output';
          outputLine.textContent = cmd.output;
          content.appendChild(outputLine);
          
          // Animate output appearance
          if (!prefersReduced) {
            gsap.from(outputLine, {
              opacity: 0,
              y: 10,
              duration: 0.3,
              ease: 'power2.out',
            });
          }
        }
        
        // Scroll to bottom
        content.scrollTop = content.scrollHeight;
        
        // Wait before next command
        await new Promise(r => setTimeout(r, cmd.delay ?? 800));
      }
      
      // Keep cursor blinking at end
      cursor.style.display = 'inline-block';
    }

    // Trigger on scroll into view
    ScrollTrigger.create({
      trigger: terminal,
      start: 'top 80%',
      once: true,
      onEnter: () => runCommands(),
    });
  })();
</script>

<style>
  .terminal {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    font-family: var(--font-code);
    font-size: 14px;
    line-height: 1.6;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid var(--border);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.close { background: #ff5f57; }
  .dot.minimize { background: #febc2e; }
  .dot.maximize { background: #28ca42; }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--font-ui);
  }

  .terminal-body {
    padding: 16px;
    min-height: 200px;
    max-height: 400px;
  }

  .terminal-content {
    margin-bottom: 16px;
  }

  .terminal-line {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--text);
  }

  .terminal-line .prompt {
    color: var(--gold);
    white-space: nowrap;
  }

  .terminal-line .command {
    color: var(--text);
  }

  .terminal-output {
    color: var(--muted);
    margin-left: 24px;
    margin-bottom: 8px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-input-line {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
  }

  .terminal-input-line .prompt {
    color: var(--gold);
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.2em;
    background: var(--gold);
    margin-left: 2px;
    vertical-align: text-bottom;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>