---
// FormField component - accessible form input with validation
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  value?: string;
  error?: string;
  options?: { value: string; label: string }[];
  class?: string;
}

const {
  label,
  name,
  type = 'text',
  required = false,
  placeholder = '',
  value = '',
  error,
  options = [],
  class: className = '',
} = Astro.props;

const id = `form-${name}`;
const describedBy = error ? `${id}-error` : undefined;
---

<div class={`form-field ${className}`}>
  <label for={id} class="block text-sm font-medium text-text mb-2">
    {label}
    {required && <span class="text-gold ml-1" aria-hidden="true">*</span>}
  </label>
  
  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      required={required}
      placeholder={placeholder}
      value={value}
      class="w-full px-4 py-3 bg-surface border border-border rounded-lg text-text placeholder-muted focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/20 transition-all duration-200 resize-y min-h-[120px]"
      aria-describedby={describedBy}
      aria-invalid={!!error}
    />
  ) : type === 'select' ? (
    <select
      id={id}
      name={name}
      required={required}
      class="w-full px-4 py-3 bg-surface border border-border rounded-lg text-text focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/20 transition-all duration-200 appearance-none"
      aria-describedby={describedBy}
      aria-invalid={!!error}
    >
      <option value="" disabled selected>{placeholder}</option>
      {options.map(opt => (
        <option value={opt.value} selected={value === opt.value}>{opt.label}</option>
      ))}
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      required={required}
      placeholder={placeholder}
      value={value}
      class="w-full px-4 py-3 bg-surface border border-border rounded-lg text-text placeholder-muted focus:outline-none focus:border-gold focus:ring-2 focus:ring-gold/20 transition-all duration-200"
      aria-describedby={describedBy}
      aria-invalid={!!error}
    />
  )}
  
  {error && (
    <p id={`${id}-error`} class="mt-2 text-sm text-gold" role="alert">{error}</p>
  )}
</div>

<style>
  .form-field input:-webkit-autofill,
  .form-field textarea:-webkit-autofill,
  .form-field select:-webkit-autofill {
    -webkit-box-shadow: 0 0 0 1000px var(--surface) inset !important;
    box-shadow: 0 0 0 1000px var(--surface) inset !important;
    -webkit-text-fill-color: var(--text) !important;
  }
</style>