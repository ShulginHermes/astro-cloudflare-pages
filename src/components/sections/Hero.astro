---
// Hero section - Full-screen with particle field, animated title, scroll indicator
// client:visible for GSAP animations
import ParticleField from '../../components/3d/ParticleField.astro';
import Button from '../../components/ui/Button.astro';
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class={`hero ${className}`} id="hero" aria-labelledby="hero-title">
  <div class="hero-background">
    <ParticleField />
    <div class="hero-grid-overlay" aria-hidden="true"></div>
  </div>
  
  <div class="hero-content container">
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title" data-split-text>
        Building <span class="text-gradient-gold">Digital</span> Experiences<br>
        That <span class="text-gradient-gold">Matter</span>
      </h1>
      <p class="hero-subtitle" data-fade-up>
        I craft high-performance web applications, AI-powered solutions, and intelligent automation systems. 
        Clean code. Thoughtful design. Measurable impact.
      </p>
      <div class="hero-cta" data-fade-up data-delay="200">
        <Button variant="primary" href="#work" class="hero-btn-primary">
          View Selected Work
        </Button>
        <Button variant="ghost" href="#contact" class="hero-btn-secondary">
          Start a Project
        </Button>
      </div>
    </div>
    
    <div class="hero-stats" data-fade-up data-delay="400">
      <div class="stat">
        <span class="stat-value" data-count="50">0</span>
        <span class="stat-suffix">+</span>
        <span class="stat-label">Projects Delivered</span>
      </div>
      <div class="stat">
        <span class="stat-value" data-count="12">0</span>
        <span class="stat-suffix">+</span>
        <span class="stat-label">Years Experience</span>
      </div>
      <div class="stat">
        <span class="stat-value" data-count="98">0</span>
        <span class="stat-suffix">%</span>
        <span class="stat-label">Client Retention</span>
      </div>
    </div>
  </div>
  
  <div class="scroll-indicator" data-scroll-indicator aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="scroll-mouse">
      <rect x="3" y="2" width="18" height="18" rx="9"/>
      <circle cx="12" cy="7" r="2" class="scroll-wheel"/>
    </svg>
    <span class="scroll-text">Scroll</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="scroll-arrow">
      <path d="M12 5v14M19 12l-7 7-7-7"/>
    </svg>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../scripts/gsap-register';
  import { prefersReducedMotion, lerp } from '../../utils/scroll';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  (() => {
    const hero = document.currentScript?.parentElement?.closest('.hero') as HTMLElement;
    if (!hero) return;

    const prefersReduced = prefersReducedMotion();

  // SplitText animation for hero title
  const titleElement = hero.querySelector('[data-split-text]') as HTMLElement;
  if (titleElement && !prefersReduced) {
    const split = new SplitText(titleElement, { type: 'lines,words,chars', linesClass: 'split-line' });
    
    gsap.from(split.chars, {
      opacity: 0,
      y: 50,
      rotationX: -90,
      duration: 1,
      stagger: 0.02,
      ease: 'back.out(1.5)',
      delay: 0.3,
    });
  } else if (titleElement) {
    titleElement.style.opacity = '1';
  }

  // Fade up animations for subtitle and buttons
  const fadeUpElements = hero.querySelectorAll('[data-fade-up]');
  fadeUpElements.forEach((el, i) => {
    const delay = parseInt((el as HTMLElement).dataset.delay || '0') / 1000;
    if (!prefersReduced) {
      gsap.from(el, {
        opacity: 0,
        y: 30,
        duration: 0.8,
        delay: 0.6 + delay,
        ease: 'power3.out',
      });
    } else {
      (el as HTMLElement).style.opacity = '1';
    }
  });

  // Counter animation for stats
  const statValues = hero.querySelectorAll('[data-count]');
  statValues.forEach(el => {
    const target = parseInt((el as HTMLElement).dataset.count || '0');
    if (!prefersReduced) {
      gsap.to(el, {
        innerText: target,
        duration: 2,
        delay: 1,
        ease: 'power2.out',
        snap: { innerText: 1 },
        onUpdate: function() {
          el.innerText = Math.round(this.targets()[0].innerText).toString();
        },
      });
    } else {
      el.innerText = target.toString();
    }
  });

  // Scroll indicator animation
  const scrollIndicator = hero.querySelector('[data-scroll-indicator]') as HTMLElement;
  const scrollArrow = hero.querySelector('.scroll-arrow') as HTMLElement;
  
  if (scrollArrow && !prefersReduced) {
    gsap.to(scrollArrow, {
      y: 10,
      duration: 1.5,
      repeat: -1,
      yoyo: true,
      ease: 'power2.inOut',
    });
  }

  // Hide scroll indicator on scroll
  if (scrollIndicator && !prefersReduced) {
    ScrollTrigger.create({
      trigger: 'body',
      start: 'top top',
      end: '100px top',
      onUpdate: (self) => {
        const opacity = 1 - Math.min(self.progress * 3, 1);
        scrollIndicator.style.opacity = opacity.toString();
        scrollIndicator.style.pointerEvents = opacity > 0.1 ? 'auto' : 'none';
      },
    });
  }

  // Smooth scroll to work section
  const workLink = hero.querySelector('a[href="#work"]');
  if (workLink) {
    workLink.addEventListener('click', async (e) => {
      e.preventDefault();
      const target = document.getElementById('work');
      if (target) {
        const { getLenis } = await import('../../scripts/lenis');
        const lenis = getLenis();
        if (lenis) {
          lenis.scrollTo(target, { offset: -80 });
        } else {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  }

  // Parallax effect on grid overlay
  const gridOverlay = hero.querySelector('.hero-grid-overlay') as HTMLElement;
  if (gridOverlay && !prefersReduced) {
    gsap.to(gridOverlay, {
      yPercent: 50,
      ease: 'none',
      scrollTrigger: {
        trigger: hero,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1,
      },
    });
  }
})();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 120px 0 80px;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(232, 180, 74, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232, 180, 74, 0.02) 1px, transparent 1px);
    background-size: 80px 80px;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
    max-width: 100%;
  }

  .hero-text {
    max-width: 800px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero-title .split-line {
    display: inline-block;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--muted);
    line-height: 1.7;
    margin-top: 24px;
    max-width: 600px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }

  .hero-btn-primary,
  .hero-btn-secondary {
    padding: 16px 32px;
    font-size: 0.95rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    width: 100%;
    max-width: 800px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: var(--text);
    line-height: 1;
  }

  .stat-suffix {
    font-family: var(--font-display);
    color: var(--gold);
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    z-index: 10;
    transition: opacity 0.5s ease;
  }

  .scroll-mouse {
    width: 26px;
    height: 42px;
    stroke: currentColor;
  }

  .scroll-wheel {
    animation: scrollWheel 1.5s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes scrollWheel {
    0% { opacity: 1; cy: 7; }
    50% { opacity: 0.3; cy: 14; }
    100% { opacity: 1; cy: 7; }
  }

  .scroll-text {
    white-space: nowrap;
  }

  .scroll-arrow {
    width: 24px;
    height: 24px;
    stroke: var(--gold);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 100px 0 60px;
    }
    
    .hero-stats {
      gap: 24px;
    }
    
    .scroll-indicator {
      bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-wheel,
    .scroll-arrow {
      animation: none !important;
    }
  }
</style>